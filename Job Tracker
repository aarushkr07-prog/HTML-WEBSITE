}

.step-node.active .step-circle {
    background: var(--secondary);
    border-color: var(--secondary);
    color: #ffffff;
    box-shadow: 0 0 0 4px var(--secondary-soft);
}

.step-label {
    font-size: 0.72rem;
    font-weight: 600;
